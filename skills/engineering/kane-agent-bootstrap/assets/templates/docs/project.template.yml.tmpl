# 项目执行环境模板。采用时复制为目标项目根目录下的 project.yml，填写后由 Agent 默认读取。
# schema_version 标识清单格式；本模板没有配套执行器或 schema 校验器。
# 替换所有 <...>；删除示例条目后，已确认没有的列表/映射写 []/{}。
# null 或省略表示尚未声明，不能当作“不需要”；占位值不可用于执行。
# 路径相对目标项目根目录（project.yml 所在目录），不以本模板的 docs 目录为基准。
# 不保存凭据值、私有地址或本机绝对路径。
schema_version: 1

project:
  name: "<项目标识>"
  purpose: "<服务对象与最重要的质量目标>"
  language: "<文档与协作语言>"
  timezone: "<任务记录采用的 IANA 时区>"

environment:
  supported_platforms: null             # 按项目填写操作系统/架构范围；未知时保留 null。
  toolchains:
    - name: "<语言、运行时或构建工具>"
      version_source: "<实际依赖清单、锁文件、工具配置或镜像声明位置>"
      check: "<无副作用的版本核对命令或步骤>"
  commands:
    "<用途，例如 test>":
      run: "<实际命令或手工操作步骤>"
      working_directory: "."
      definition_source: "<实际入口的定义位置或权威操作说明>"
      prerequisites: []                 # 工具、变量名称、服务与权限需求。
      side_effects: []                  # 文件、网络、端口与外部状态变化；未知时用 null。
      verification_scope: "<能验证的行为与未覆盖边界>"
      failure_handling: "<失败判定、超时、取消及恢复方式；复杂流程可引用文档>"
  services:
    - name: "<必需服务>"
      connection_source: "<连接配置位置或变量名，不写秘密值>"
      start: "<commands 中的命令键或外部维护方>"
      readiness: "<就绪核对方式>"
      stop: "<commands 中的命令键或外部维护方>"
  tools:
    - name: "<技能、插件、MCP 或其他工具>"
      provided_by: "<项目、宿主环境或用户扩展>"
      source: "<权威来源或所属管理器>"
      version_source: null              # 可获得的接口/版本来源；不能固定时如实保留未知。
      required_for: "<触发任务或用途>"
  variables:
    - name: "<环境变量名称>"
      purpose: "<用途与必需场景>"
      source: "<配置入口或密钥管理器名称；不记录变量值>"
  local_paths:
    "<本地状态、缓存或证据的用途>":
      path: "<项目根目录下的相对路径>"
      retention: "<临时或持久；清理责任与保留要求>"

# 记录执行所需能力，不授予访问权限，也不代替当前用户授权。
requirements:
  filesystem:
    - path: "<项目内相对路径>"
      access: ["<所需读或写能力>"]
      purpose: "<适用任务>"
  network: []                          # 需要时登记用途、目标范围和配置来源，不写凭据。

guides:
  environment: "docs/agent-environment/README.md"
  commands: "docs/agent-environment/commands.md"
