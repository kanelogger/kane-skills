# 项目环境清单。下方路径相对项目根目录。
# null 表示待核实。[] 或 {} 表示已确认无相应条目。
# 记录实际入口、事实来源和运行需求。凭据只记录配置入口或变量名。
schema_version: 1

project:
  name: null       # 填项目唯一标识。
  purpose: null    # 填服务对象与最重要的目标。
  language: null   # 按项目实际协作语言填写。
  timezone: null   # 使用项目实际约定的 IANA 时区。

environment:
  supported_platforms: null
  toolchains: null
  commands: null
  services: null
  tools: null
  variables: null
  local_paths: null

requirements:
  filesystem: null
  network: null

# 只有采用对应指南时才填写真实路径。
guides:
  environment: null
  commands: null
